# Every setting the stack reads is listed here. All have working defaults.
# docker compose reads a .env file next to compose.yaml; for local runs, export what you change.

# SQLite file used by the backend. Local default: backend/data/app.db.
# In Docker it lives on the backend-data volume: sqlite:////app/data/app.db
# DATABASE_URL=sqlite:///./data/app.db

# Host ports used by docker compose (bound to 127.0.0.1 only).
BACKEND_PORT=8000
FRONTEND_PORT=8501
