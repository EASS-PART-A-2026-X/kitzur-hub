#!/bin/sh
# Reject AI attribution in commit messages (project rule). Enable once per clone:
#   git config core.hooksPath scripts/hooks
if grep -Eiq 'co-authored-by:.*(claude|anthropic|openai|copilot|cursor)|generated with \[?(claude|chatgpt|cursor|copilot)|claude-session|noreply@anthropic\.com' "$1"; then
  echo "commit-msg: remove the AI attribution line from the commit message (see AGENTS.md)." >&2
  exit 1
fi
