    "/courses/{course_id}/lectures/import": {
      "post": {
        "tags": [
          "lectures"
        ],
        "summary": "Import Lecture",
        "description": "Create a lecture from an uploaded transcript file.\n\nAccepted: Kitzur ``.transcript.md``, raw Zoom ``.json``, ``.vtt`` and ``.txt``.\nSpeakers are anonymized before anything is stored.\n\nDeveloper note: the body is read with a cap of MAX_UPLOAD_BYTES + 1 so an\noversized upload is detected without loading the whole file into memory.\n\nRaises:\n    HTTPException: 404 unknown course, 409 same transcript already in this\n        course, 413 file too large, 415 unsupported format, 422 unusable content.",
        "operationId": "import_lecture_courses__course_id__lectures_import_post",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Course Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_lecture_courses__course_id__lectures_import_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LecturePublic"
                }
              }
            }
          },
          "409": {
            "description": "Conflict"
          },
          "413": {
            "description": "Content Too Large"
          },
          "415": {
            "description": "Unsupported Media Type"
          },
          "422": {
            "description": "Unprocessable Content"
          }
        }
      }
    },
